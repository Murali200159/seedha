{
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "target": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "index.js"
  ],
  "exclude": [
    "node_modules",
    "supabase",
    "vite.config.ts"
  ]
}
