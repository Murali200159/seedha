PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seedha_properties?schema=public"
JWT_SECRET="seedha_properties_jwt_secret_2026_secure_key"
JWT_EXPIRATION="7d"
CORS_ORIGIN="*"

# ========================================================
# SMTP Mail Configuration
# For Gmail: Use smtp.gmail.com, port 587 (or 465), and generate an "App Password"
# For Outlook / Office 365: smtp.office365.com, port 587
# For Custom / Amazon SES: your-ses-host, port 587
# If left blank, the server logs emails directly to the console (simulation mode)
# ========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Seedha Properties <noreply@seedhaproperties.com>"
